{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AuraSentinel",
  "version": "4.8.0",
  "identifier": "com.yemsy.aurasentinel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Aura Sentinel",
        "width": 1500,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:*; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; frame-src http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Ramón Antonio Burgos Jerez (yemsy26)",
    "copyright": "© 2026 Ramón Antonio Burgos Jerez (yemsy26). Licencia MIT.",
    "license": "MIT",
    "homepage": "https://github.com/yemsy26/aura-sentinel",
    "category": "DeveloperTool",
    "shortDescription": "IDE con agente de programación local",
    "longDescription": "Entorno de desarrollo para Windows con editor Monaco y un agente que planifica, escribe, ejecuta y verifica código usando un modelo local servido por LM Studio.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../motor/agente/*.py": "motor/agente/",
      "../motor/agente/guias/*.md": "motor/agente/guias/",
      "../motor/agente/sondas/*.py": "motor/agente/sondas/",
      "../motor/tests/*.py": "motor/tests/",
      "../motor/agente.json": "motor/agente.json",
      "../motor/agente_mcp.py": "motor/agente_mcp.py",
      "../motor/PROMPT_SISTEMA_MCP.txt": "motor/PROMPT_SISTEMA_MCP.txt",
      "../motor/LEEME.md": "motor/LEEME.md",
      "../motor/agente.bat": "motor/agente.bat",
      "../motor/cargar_modelo.bat": "motor/cargar_modelo.bat",
      "../motor/descargar_modelo.bat": "motor/descargar_modelo.bat",
      "../motor/instalar.bat": "motor/instalar.bat",
      "../motor/probar.bat": "motor/probar.bat",
      "../motor/vision.bat": "motor/vision.bat"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
